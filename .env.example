# Database Connection URL
# Local Development (SQLite):
DATABASE_URL="file:./dev.db"
# Vercel Production (PostgreSQL - Neon, Supabase, Vercel Postgres):
# DATABASE_URL="postgresql://user:password@ep-host.eu-central-1.aws.neon.tech/property_rate_db?sslmode=require"

# Paystack Payment Gateway API Keys
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# App Base URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"

# Twilio SMS Gateway Credentials (Optional)
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_PHONE_NUMBER="+1234567890"

# Africa's Talking SMS Credentials (Optional)
AT_USERNAME="sandbox"
AT_API_KEY="atsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
